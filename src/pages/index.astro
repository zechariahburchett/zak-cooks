---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { Image as AstroImage } from "astro:assets";
import profilePic from "@/assets/images/ZakPhoto.jpg";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
<section id="hero" class="border-border border-b pt-8 pb-6">
  {/* THIS FLEX CONTAINER WRAPS THE IMAGE AND TEXT TOGETHER */}
  <div class="flex flex-col sm:flex-row items-center gap-6 mb-6">
    
    {/* THE CIRCULAR IMAGE */}
    <div class="shrink-0">
      <AstroImage 
        src={profilePic} 
        alt="Zak smiling"
        width={112}
        height={112}
        class="rounded-full w-24 h-24 sm:w-28 sm:h-28 object-cover border-4 border-skin-accent"
      />
    </div>

    {/* THE INTRODUCTORY TEXT */}
    <div class="flex-1 text-center sm:text-left">
      <p class="mb-4">
        A simple family recipe collection.
        <strong class="text-skin-accent font-bold block mt-2">
          Free. No ads. No popups. No life stories to scroll through before getting to the recipe.
        </strong>
      </p>
    </div>
  </div>

  <p>
    Just home-tested, family-approved food cooked and served right in my own kitchen. If you like a recipe, feel free to <a href="https://buymeacoffee.com/zakcooks" target="_blank" rel="noopener noreferrer" class="text-skin-accent underline decoration-dashed underline-offset-4 hover:underline-offset-2">buy me a coffee</a>. No worries if you don't!
  </p>
</section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
